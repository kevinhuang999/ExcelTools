<DnaLibrary Name="ExcelTools" RuntimeVersion="v6.0">
  <!-- ExplicitExports=true: 只导出显式标注 [ExcelFunction] 的方法。
       本项目不对外提供 Excel 公式函数（入口全走 ribbon onAction），
       设为 true 可避免 MyTools/RibbonCommands 的 public static 方法
       （含 FormatToText 同名重载）被自动注册为 Excel 函数。
       onAction 按方法名反射查找，不受此设置影响。 -->
  <ExternalLibrary Path="ExcelTools.dll" LoadFromBytes="true" ExplicitExports="true" />
  <CustomUI>
    <customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="OnRibbonLoad">
      <ribbon>
        <tabs>
          <tab id="ExcelToolsTab" label="Excel 工具">
            <group id="grpData" label="数据处理">
              <button id="btnSeperate" label="拆分工作表" size="large"
                      imageMso="Split" onAction="OnSeperateClick"
                      screentip="按某列值将总表拆成多个工作表" />
              <button id="btnFilter" label="条件筛选" size="large"
                      imageMso="Filter" onAction="OnFilterClick"
                      screentip="按多条件筛选数据到新表" />
              <button id="btnSort" label="按列排序" size="large"
                      imageMso="SortUp" onAction="OnSortClick"
                      screentip="按指定列排序并保留原始数据副本" />
              <button id="btnDelete" label="删除匹配行" size="large"
                      imageMso="Delete" onAction="OnDeleteClick"
                      screentip="删除与另一表匹配的行" />
            </group>
            <group id="grpCompare" label="比对">
              <button id="btnCompare" label="两表比对" size="large"
                      imageMso="CompareAndMerge" onAction="OnCompareClick"
                      screentip="比较两个工作表的数据差异" />
              <button id="btnTimeCompare" label="差异比对" size="large"
                      imageMso="Filter" onAction="OnTimeCompareClick"
                      screentip="按匹配列联表找比对列不一致的行" />
              <button id="btnCountDistinct" label="累计去重计数" size="large"
                      imageMso="CountNumber" onAction="OnCountDistinctClick"
                      screentip="截至每行统计某列累计不重复值数" />
            </group>
            <group id="grpStat" label="统计">
              <button id="btnGroupStat" label="分组统计" size="large"
                      imageMso="PivotTable" onAction="OnGroupStatClick"
                      screentip="按分类字段生成交叉汇总表" />
              <button id="btnPermMatrix" label="权限矩阵" size="large"
                      imageMso="InsertFunction" onAction="OnPermMatrixClick"
                      screentip="从数据生成角色×功能权限矩阵" />
              <button id="btnGetFileNames" label="文件名列表" size="large"
                      imageMso="FileNew" onAction="OnGetFileNamesClick"
                      screentip="递归提取目录下所有文件名到当前表" />
            </group>
            <group id="grpMatch" label="匹配">
              <button id="btnKeyMatch" label="多字段匹配" size="large"
                      imageMso="LookupWizard" onAction="OnKeyMatchClick"
                      screentip="按多字段联合匹配两表提取Key值" />
            </group>
          </tab>
        </tabs>
      </ribbon>
    </customUI>
  </CustomUI>
</DnaLibrary>
